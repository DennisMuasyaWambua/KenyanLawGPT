# Copy to .env — docker-compose picks it up automatically. Everything has a
# dev-safe default; the platform runs fully offline with no keys set.

# --- Security (change for anything beyond local dev) ---
JWT_SECRET=dev-only-secret-change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- LLM (Claude via Anthropic API). Empty => deterministic offline mock. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Embeddings (voyage-law-2, 1024-dim). Empty => hashing embedder. ---
VOYAGE_API_KEY=

# --- Public corpus ingestion: true = built-in Kenyan-law samples (offline),
#     false = live crawl of kenyalaw.org on the daily/weekly schedules. ---
INGEST_OFFLINE_SAMPLES=true

# --- Africa's Talking (SMS). Empty => log-only mode. ---
AT_USERNAME=
AT_API_KEY=

# --- M-Pesa Daraja (sandbox). Empty => STK endpoints return 501. ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
# Must be reachable by Safaricom in real use (ngrok etc.); slug is appended.
DARAJA_CALLBACK_URL=http://localhost:8080/webhooks/daraja/callback

# --- Judiciary case-status source. Empty => deterministic mock adapter. ---
JUDICIARY_BASE_URL=

# --- Transactional email. Empty => log-only mode. ---
SMTP_HOST=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
