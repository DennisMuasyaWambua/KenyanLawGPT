# Advocatus production env for the Contabo box (169.58.94.243), which already
# runs law-rag + SmartNyumba. Copy to `.env`, fill the secrets, keep out of git.

# --- Host port map (loopback; host nginx terminates TLS in front) ------------
# 8080 is taken by SmartNyumba's docker nginx on this box, so the gateway moves.
GATEWAY_HOST_PORT=8090
FRONTEND_HOST_PORT=3000
# Leave the data-service ports on their defaults (loopback only): 55432/7474/
# 7687/56379/59000/59001/50051/8081.

# --- Neo4j (Community). Capped so it coexists with the other apps. -----------
NEO4J_PASSWORD=CHANGE-ME-strong-neo4j
NEO4J_HEAP=768m
NEO4J_PAGECACHE=384m

# --- LLM: reuse the Ollama already running under law-rag on the host. --------
# The ai container reaches the host via the docker bridge; the runbook adds
# `extra_hosts: host.docker.internal:host-gateway` to the ai service.
# IMPORTANT: this box has ~7.9GB RAM shared with Postgres/Neo4j/MinIO/SmartNyumba.
# The 8B `llama3` needs ~5GB resident and, paired with a separate fast model,
# forces Ollama to evict+reload under swap on every query — which drops the
# /api/generate call and surfaces as a 502 "ai service unavailable". Use ONE
# small model for both synthesis and classification so exactly one model stays
# resident (no thrash). llama3.2:3b (~2.5GB) is the quality/size sweet spot here;
# drop both to llama3.2:1b if memory is still tight. `ollama pull llama3.2:3b`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=llama3.2:3b

# --- Public URLs (cutover: the new stack answers on the law domains) ---------
NEXT_PUBLIC_API_URL=https://lawapi.dennismuasya.com
CORS_ORIGINS=https://law.dennismuasya.com
# Used to build staff-invite accept links (must be the browser-facing origin).
APP_BASE_URL=https://law.dennismuasya.com
# Presigned upload/download URLs the BROWSER uses. Firm ingestion is flag-dark
# for v1; when enabling it, expose MinIO on a public route (e.g.
# files.dennismuasya.com) or switch S3_* to Cloudflare R2.
S3_PUBLIC_ENDPOINT=files.dennismuasya.com

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=CHANGE-ME-strong-jwt-secret

# Bootstrap super-admin for the platform control center (/admin). Set a strong
# password; only used to seed the first admin if none exists.
PLATFORM_ADMIN_EMAIL=admin@ckarwithack.co.ke
PLATFORM_ADMIN_PASSWORD=CHANGE-ME-strong-admin-password
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME-strong

# --- New capabilities ship dark; enable per pilot firm once validated. -------
ENABLE_FIRM_INGESTION=false
ENABLE_JUDGE_REASONING=false
ENABLE_AUTO_UPDATE=false

# --- Google sign-in / sign-up (optional; empty => Google buttons hidden) -----
# Create an OAuth "Web" client in Google Cloud Console; add authorized JS origin
# https://law.dennismuasya.com. Both vars take the SAME client id. The frontend
# one is a build arg, so `docker compose build frontend` is required to apply it.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GMI Cloud model evaluation (optional; empty key => provider unused) ------
GMI_CLOUD_API_KEY=
# Non-prod safety gate is on by default; APP_ENV=dev here, so to actually call
# GMI you must attest the corpus is synthetic:
GMI_SYNTHETIC_DATA_OK=false

# --- Speech-to-text (optional). "auto" uses local Whisper if installed, else a
# mock. Set TRANSCRIBE_PROVIDER=openai + TRANSCRIBE_API_KEY only if you accept
# sending (potentially privileged) audio off-box. ----------------------------
TRANSCRIBE_PROVIDER=auto
TRANSCRIBE_API_KEY=

# --- Integrations (optional; empty => log-only / disabled) -------------------
ANTHROPIC_API_KEY=
AT_USERNAME=
AT_API_KEY=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
SMTP_HOST=
