# WakiliAI production env for the Contabo box (169.58.94.243), which already
# runs law-rag + SmartNyumba. Copy to `.env`, fill the secrets, keep out of git.

# --- Host port map (loopback; host nginx terminates TLS in front) ------------
# 8080 is taken by SmartNyumba's docker nginx on this box, so the gateway moves.
GATEWAY_HOST_PORT=8090
FRONTEND_HOST_PORT=3000
# Leave the data-service ports on their defaults (loopback only): 55432/7474/
# 7687/56379/59000/59001/50051/8081.

# --- Neo4j (Community). Capped so it coexists with the other apps. -----------
NEO4J_PASSWORD=CHANGE-ME-strong-neo4j
NEO4J_HEAP=768m
NEO4J_PAGECACHE=384m

# --- LLM: reuse the llama3 already running under Ollama on the host. ---------
# The ai container reaches the host via the docker bridge; the runbook adds
# `extra_hosts: host.docker.internal:host-gateway` to the ai service.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Public URLs (cutover: the new stack answers on the law domains) ---------
NEXT_PUBLIC_API_URL=https://lawapi.dennismuasya.com
CORS_ORIGINS=https://law.dennismuasya.com
# Presigned upload/download URLs the BROWSER uses. Firm ingestion is flag-dark
# for v1; when enabling it, expose MinIO on a public route (e.g.
# files.dennismuasya.com) or switch S3_* to Cloudflare R2.
S3_PUBLIC_ENDPOINT=files.dennismuasya.com

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=CHANGE-ME-strong-jwt-secret
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME-strong

# --- New capabilities ship dark; enable per pilot firm once validated. -------
ENABLE_FIRM_INGESTION=false
ENABLE_JUDGE_REASONING=false
ENABLE_AUTO_UPDATE=false

# --- Integrations (optional; empty => log-only / disabled) -------------------
ANTHROPIC_API_KEY=
AT_USERNAME=
AT_API_KEY=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
SMTP_HOST=
