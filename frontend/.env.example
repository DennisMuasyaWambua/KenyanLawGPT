# Base URL of the WakiliAI backend API (no trailing slash).
#
# Local dev (npm run dev): copy this to .env and use the raw-IP HTTP backend.
#   VITE_API_BASE_URL=http://169.58.94.243
#
# Production build (npm run build): .env.production is used automatically and
# targets the HTTPS API subdomain. Do not point an HTTPS-served frontend at the
# plain-HTTP raw IP — browsers block that as mixed content.
VITE_API_BASE_URL=http://169.58.94.243
