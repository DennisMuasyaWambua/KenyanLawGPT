# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
# Base domain for subdomain tenant routing ({slug}.wakili.ai in production).
NEXT_PUBLIC_BASE_DOMAIN=localhost
# Google Identity Services OAuth client id — enables "Sign in / up with Google".
# Leave empty to hide the Google buttons and use password auth only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
