# Python AI/RAG service — every consumed variable (defaults in app/config.py).
APP_ENV=dev
# Port matches the compose-published host port (shifted to 55432).
DATABASE_URL=postgresql://wakili_app:wakili_app_pw@localhost:55432/wakili

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wakili-neo4j

S3_ENDPOINT=localhost:59000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wakili-documents
S3_USE_SSL=false

# LLM provider: auto|anthropic|mock (auto = anthropic when key set, else mock)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Embeddings: auto|voyage|hash (dimensions must match the vector(1024) columns)
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
EMBEDDING_DIM=1024

GRPC_PORT=50051
HEALTH_PORT=8081
MTLS_CA_CERT=../../infra/certs/ca.crt
MTLS_SERVER_CERT=../../infra/certs/ai.crt
MTLS_SERVER_KEY=../../infra/certs/ai.key
MTLS_DISABLED=false

KENYALAW_BASE=https://new.kenyalaw.org
PUBLIC_INGEST_ON_START=true
INGEST_OFFLINE_SAMPLES=true
INGEST_DAILY_SECONDS=86400
INGEST_WEEKLY_SECONDS=604800
