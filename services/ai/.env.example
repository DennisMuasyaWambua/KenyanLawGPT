# Python AI/RAG service — every consumed variable (defaults in app/config.py).
APP_ENV=dev
# Port matches the compose-published host port (shifted to 55432).
DATABASE_URL=postgresql://wakili_app:wakili_app_pw@localhost:55432/wakili

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wakili-neo4j

S3_ENDPOINT=localhost:59000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wakili-archives
S3_USE_SSL=false

# LLM provider: auto|anthropic|ollama|gmi|mock (auto = anthropic when key set, else mock)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# GMI Cloud — OpenAI-compatible hosted inference (model evaluation: DeepSeek vs Qwen3).
# GMI_CLOUD_MODEL is the default when LLM_PROVIDER=gmi; the A/B script uses the
# two model-specific vars below. Never commit a real key — rotate if leaked.
GMI_CLOUD_BASE_URL=https://api.gmi-serving.com/v1
GMI_CLOUD_API_KEY=
GMI_CLOUD_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
GMI_CLOUD_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
GMI_CLOUD_QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8
# Synthetic-data-only gate for GMI (paid, external). Outside prod, GMI calls are
# refused unless GMI_SYNTHETIC_DATA_OK=true attests the corpus is synthetic.
GMI_SYNTHETIC_ONLY=true
GMI_SYNTHETIC_DATA_OK=false

# Speech-to-text (multilingual). auto|whisper|openai|mock. "auto" only ever uses
# a LOCAL Whisper or the offline mock — cloud (openai) must be chosen explicitly
# because client audio is privileged/KDPA-sensitive. Whisper auto-detects language.
TRANSCRIBE_PROVIDER=auto
WHISPER_MODEL=base
TRANSCRIBE_LANGUAGE=auto
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_OPENAI_MODEL=whisper-1

# Embeddings: auto|voyage|hash (dimensions must match the vector(1024) columns)
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
EMBEDDING_DIM=1024

GRPC_PORT=50051
HEALTH_PORT=8081
MTLS_CA_CERT=../../infra/certs/ca.crt
MTLS_SERVER_CERT=../../infra/certs/ai.crt
MTLS_SERVER_KEY=../../infra/certs/ai.key
MTLS_DISABLED=false

KENYALAW_BASE=https://new.kenyalaw.org
PUBLIC_INGEST_ON_START=true
INGEST_OFFLINE_SAMPLES=true
INGEST_DAILY_SECONDS=86400
INGEST_WEEKLY_SECONDS=604800
