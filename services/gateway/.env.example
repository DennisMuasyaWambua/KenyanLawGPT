# Go API gateway — every consumed variable (defaults in internal/config).
APP_ENV=dev
PORT=8080
BASE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# Ports below match the compose-published host ports (shifted to 55xxx/59xxx).
DATABASE_URL=postgres://wakili_app:wakili_app_pw@localhost:55432/wakili?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:55432/wakili?sslmode=disable
MIGRATIONS_DIR=../../infra/migrations
REDIS_ADDR=localhost:56379

JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Google Identity Services OAuth client id (id-token audience). Empty disables
# audience checking (dev only). APP_BASE_URL is the public frontend origin used
# to build staff-invite accept links.
GOOGLE_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# Bootstrap super-admin (platform control plane). Ensured on gateway start when
# both are set. The control center lives at the unlisted /admin route.
PLATFORM_ADMIN_EMAIL=admin@ckarwithack.co.ke
PLATFORM_ADMIN_PASSWORD=ChangeMe_Admin123!

AI_GRPC_ADDR=localhost:50051
AI_GRPC_SERVER_NAME=ai
MTLS_CA_CERT=../../infra/certs/ca.crt
MTLS_CLIENT_CERT=../../infra/certs/gateway.crt
MTLS_CLIENT_KEY=../../infra/certs/gateway.key

S3_ENDPOINT=localhost:59000
# Browser-reachable endpoint used only when minting presigned URLs:
S3_PUBLIC_ENDPOINT=localhost:59000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wakili-archives
S3_USE_SSL=false

AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=WAKILI
AT_BASE_URL=https://api.sandbox.africastalking.com

DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORT_CODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=http://localhost:8080/webhooks/daraja/callback

JUDICIARY_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@wakili.ai

RATE_LIMIT_PER_MIN=300
REMINDERS_INTERVAL=10m
RECONCILE_INTERVAL=15m
